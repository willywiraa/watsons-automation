<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS front end for the hosted WatsonsTester (docs/server-deployment.md).
  The IIS site's folder holds only this file. IIS passes the requests for the app's address,
  http(s)://<VM>/automation/ (since 2026-10-22), to the WatsonsTester service on this computer
  (http://127.0.0.1:3000) without "/automation"; the service does the sign-in itself. The page
  asks for everything relative to its own address, so the path is set only here, in the two
  rules below. Nothing is served from disk, so /automation/users.json and the like return 404.
  Needs: URL Rewrite, and Application Request Routing (ARR) with its proxy enabled. In ARR's
  "Server Proxy Settings": keep "Preserve client IP in X-Forwarded-For" on, and set
  "Response buffer threshold" to 0 (live progress would otherwise arrive late).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- The site's root and "/automation" lead to "/automation/": the page's addresses are
             relative to it, so it needs the final slash. -->
        <rule name="WatsonsTester address" stopProcessing="true">
          <match url="^(automation)?$" />
          <action type="Redirect" url="/automation/" redirectType="Found" />
        </rule>
        <rule name="WatsonsTester service" stopProcessing="true">
          <match url="^automation/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" logRewrittenUrl="false" />
        </rule>
      </rules>
    </rewrite>
    <!-- No default documents or folder listings: everything goes to the service. -->
    <defaultDocument enabled="false" />
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <!-- The service accepts at most 200 KB per request. -->
        <requestLimits maxAllowedContentLength="1048576" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <!-- HTTPS only, from the first visit on. -->
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
