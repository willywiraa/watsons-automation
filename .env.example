# The list of settings this project needs. Copy this file to ".env" and fill in
# the values there. Never put real values in this file: Git saves it.

# Watsons STAGING website address (never production).
WATSONS_STAGING_URL=

# Staging test account.
WATSONS_USERNAME=
WATSONS_PASSWORD=

# Staging backoffice account with the Customer Support Manager role. Approves ("validates") each
# new order, and is needed to approve an existing one. Optional for new orders: leave both empty
# and the run stops at "Thank you for your order"; the order then waits for approval.
WATSONS_BACKOFFICE_USERNAME=
WATSONS_BACKOFFICE_PASSWORD=

# Optional: one-time code (OTP) for the staging payment step. Without it, 1234 is used
# (the code staging shows).
# WATSONS_PAYMENT_OTP=1234

# Optional: your name in the launcher's Logs / History. Without it, your Windows user name.
# WATSONS_OPERATOR=
